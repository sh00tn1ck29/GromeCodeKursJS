const linkAPi = 'https://6a18a2251878294b597d6a0c.mockapi.io/api/v1/users';

function getUsersList() {
  // put your code here
  return fetch(linkAPi).then(response => response.json());
}

export function getUserById(userId) {
  // put your code here
  return fetch(`${linkAPi}/${userId}`).then(response => response.json());
}

export function createUser(userData) {
  // put your code here
  return fetch(linkAPi, {
    method: 'POST',
    headers: {
      'Content-Type': 'application.json; charset=utf8;',
    },
    body: JSON.stringify(userData),
  }).then(response => response.json());
}

export function deleteUser(userId) {
  // put your code here
  return fetch(`${linkAPi}/${userId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application.json; charset=utf8;',
    },
  }).then(response => response.json());
}

export function updateUser(userId, userData) {
  // put your code here
  return fetch(`${linkAPi}/${userId}`, {
    method: 'PUT',
    headers: {
      'Content-Type': 'application.json; charset=utf8;',
    },
    body: JSON.stringify(userData),
  }).then(response => response.json());
}
